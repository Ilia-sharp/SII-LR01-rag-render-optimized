# ============================================================
# Переменные окружения (значения по умолчанию для Render Free Tier)
# ============================================================

# Бэкенд: light (ONNX, для Render) или heavy (torch+chromadb, для локальной разработки)
RAG_BACKEND=light

# Модель (используется только для отображения и сравнения с метаданными индекса)
# Для Render Free Tier по умолчанию берётся компактная rubert-tiny2 (29 МБ).
# Альтернатива: intfloat/multilingual-e5-small (470 МБ, для локальной разработки).
RAG_MODEL=cointegrated/rubert-tiny2

# Параметры чанкинга
RAG_CHUNK_WORDS=220
RAG_CHUNK_OVERLAP=0.15

# Поиск
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.35
RAG_LEXICAL_GUARD=1

# Логирование
RAG_LOG_LEVEL=INFO

# Путь к предсобранному bundle (только для light-бэкенда)
# RAG_BUNDLE_DIR=desktop/bundle

# Для heavy-бэкенда (локальная разработка)
# RAG_DATA_DIR=data
# RAG_CHROMA_DIR=.chroma

# Оптимизации для ONNX Runtime (важно для 0.1 CPU на Render Free)
OMP_NUM_THREADS=1
ORT_NUM_THREADS=1
PYTHONUNBUFFERED=1

# Офлайн-режим HuggingFace (мы уже положили модель в bundle)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
